# PrepWise backend environment.
# Copy to .env for local development:  copy .env.example .env
# Never commit .env. Values already set in the process environment win over this file.

# --- Django -----------------------------------------------------------------
# The settings module is chosen BEFORE this file is read, so set DJANGO_SETTINGS_MODULE
# in the shell or service definition, not here:
#   manage.py  -> config.settings.development (default)
#   wsgi/asgi  -> config.settings.production  (default)
#   pytest     -> config.settings.test        (from pyproject.toml)
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required in production (at least 50 random characters). Optional in development.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated host names (no scheme). Required in production; "*" is rejected.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
# text | json (production defaults to json)
DJANGO_LOG_FORMAT=text

# --- PostgreSQL ---------------------------------------------------------------
DB_NAME=prepwise
DB_USER=prepwise
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# disable | allow | prefer | require | verify-ca | verify-full (production defaults to require)
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
# Database created and destroyed by the test runner (the DB user needs CREATEDB).
DB_TEST_NAME=test_prepwise
# Optional: run the test suite on a different server from the app (e.g. local
# PostgreSQL while the app uses Supabase). Each falls back to the DB_* value.
# DB_TEST_HOST=localhost
# DB_TEST_PORT=5432
# DB_TEST_USER=prepwise
# DB_TEST_PASSWORD=
# DB_TEST_SSLMODE=prefer
# DB_TEST_MAINTENANCE_DB=prepwise

# --- CORS / CSRF ------------------------------------------------------------
# Explicit comma-separated origins (scheme://host[:port]). No wildcards.
# Production requires https:// origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Must be true: the refresh token travels in an HttpOnly cookie.
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Authentication -------------------------------------------------------------
# Refresh tokens live in an HttpOnly cookie scoped to /api/v1/auth/.
# Secure cookies need HTTPS; development defaults to false, production requires true.
AUTH_COOKIE_SECURE=false
# Lax | Strict | None. Use None only if the frontend and API are on different sites
# (None requires Secure). Frontend and API on subdomains of one site work with Lax.
AUTH_COOKIE_SAMESITE=Lax
# Optional parent domain for the cookie, e.g. .prepwise.example. Empty = API host only.
AUTH_COOKIE_DOMAIN=
# --- Sign in with Google ----------------------------------------------------------
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console > APIs & Services >
# Credentials. Add your frontend origin (e.g. http://localhost:5173) under
# "Authorized JavaScript origins". Empty = the Google button is hidden.
GOOGLE_OAUTH_CLIENT_ID=

# --- API ----------------------------------------------------------------------
# Serve /api/v1/schema/, /api/v1/docs/ and /api/v1/redoc/ (development default: true).
API_DOCS_ENABLED=true
API_THROTTLE_ANON=60/minute
API_THROTTLE_USER=240/minute
# Login, registration, Google sign-in and password change.
API_THROTTLE_AUTH=10/minute
# Requests that can call OpenAI.
API_THROTTLE_AI=20/minute
# Checkout order creation and verification.
API_THROTTLE_PAYMENTS=20/minute
# Largest accepted resume upload, in bytes (default 5 MB).
RESUME_MAX_UPLOAD_BYTES=5242880
# Optional separate JWT signing key (defaults to DJANGO_SECRET_KEY).
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- AI (OpenAI) --------------------------------------------------------------
# PrepWise's AI runs on OpenAI only, for users with an active plan (bought with
# Razorpay or granted by an administrator). Everyone else, and subscribers whose
# AI request fails, get basic (rule-based, not AI-generated) results. OpenAI API
# keys (sk-...), models, AI modes (Fast / Balanced / Advanced), token limits,
# prices, fallbacks, the optional monthly spending cap and voice limits are all
# managed in the admin panel (/admin/ai), not here. When a key hits OpenAI's rate
# limit or runs out of credit it rests and the next key takes over automatically.
#
# AI requests run inside the HTTP request; keep proxy/Gunicorn timeouts above this.
AI_REQUEST_TIMEOUT_SECONDS=120
# AES-256-GCM keys that encrypt the OpenAI API keys saved in the admin panel. Keep
# them in your secret manager, never in the database. Required in production.
# Format: <id>:<base64 32-byte key>, comma-separated. The first key encrypts; every
# listed key can decrypt. Generate one with:
#   python manage.py generate_encryption_key
# Rotation: put the new key first, deploy, run
#   python manage.py rotate_encryption_keys
# then remove the old key. Losing every key means re-adding the OpenAI keys.
AI_KEY_ENCRYPTION_KEYS=

# --- Payments -----------------------------------------------------------------
# One-time (non-recurring) plan purchases. Supported: razorpay. Empty disables
# checkout; administrators can still grant subscriptions in the admin panel.
PAYMENT_PROVIDER=
# Key ID is publishable (sent to Checkout); the key secret and webhook secret are not.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# The secret you entered when creating the webhook in the gateway dashboard.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_REQUEST_TIMEOUT_SECONDS=20

# --- Invoices and PDF reports -------------------------------------------------
# Seller details printed on invoices. PrepWise never calculates tax; set a tax ID
# only if you are registered, and confirm invoice requirements with your accountant.
INVOICE_SELLER_NAME=PrepWise
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_TAX_ID=
INVOICE_NUMBER_PREFIX=PW
# Optional path to a TrueType font so PDFs can render non-Latin text.
PDF_UNICODE_FONT_PATH=

# --- Production-only security toggles ---------------------------------------
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
